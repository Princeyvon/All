{
  "include": ["client/src/**/*", "shared/**/*", "server.ts"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "server/_core",
    "server/dailyRewindDb.ts",
    "server/db.ts",
    "client/src/components/AIChatBox.tsx",
    "client/src/components/DashboardLayout.tsx",
    "client/src/components/DashboardLayoutSkeleton.tsx",
    "client/src/components/Map.tsx",
    "client/src/components/ui/button-group.tsx",
    "client/src/components/ui/field.tsx",
    "client/src/components/ui/form.tsx",
    "client/src/components/ui/input-group.tsx"
  ],
  "compilerOptions": {
    "incremental": true,
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@assets/*": ["./attached_assets/*"]
    }
  }
}
